#!/bin/sh
# Startup script: starts the price system in the background at boot
#   price-fetcher : internet prices -> CAN bus vcan0
#   price-web     : CAN bus vcan0 -> web page with live charts on port 8080

case "$1" in
  start)
    echo "Starting price system (price-fetcher + price-web)..."
    /usr/bin/price-fetcher > /dev/null 2>&1 &
    /usr/bin/price-web > /dev/null 2>&1 &
    ;;
  stop)
    echo "Stopping price system..."
    killall price-fetcher price-web 2>/dev/null
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
