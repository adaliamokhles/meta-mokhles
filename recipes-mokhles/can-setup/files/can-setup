#!/bin/sh
# Startup script: creates the virtual CAN bus vcan0 at boot

case "$1" in
  start)
    echo "Setting up CAN bus vcan0..."
    modprobe vcan
    ip link add dev vcan0 type vcan 2>/dev/null
    ip link set up vcan0
    ;;
  stop)
    echo "Removing CAN bus vcan0..."
    ip link set down vcan0 2>/dev/null
    ip link delete vcan0 2>/dev/null
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
